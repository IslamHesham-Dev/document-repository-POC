generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  ADMIN
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  email        String     @unique
  role         UserRole   @default(EMPLOYEE)
  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  documents    Document[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("users")
}

model Document {
  id               String            @id @default(uuid()) @db.Uuid
  title            String
  uploaderId       String            @map("uploader_id") @db.Uuid
  uploader         User              @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  versions         DocumentVersion[] @relation("DocumentVersions")
  currentVersionId String?           @unique @map("current_version_id") @db.Uuid
  currentVersion   DocumentVersion?  @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  @@index([uploaderId])
  @@index([title])
  @@index([deletedAt])
  @@map("documents")
}

model DocumentVersion {
  id         String    @id @default(uuid()) @db.Uuid
  documentId String    @map("document_id") @db.Uuid
  document   Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor Document? @relation("CurrentDocumentVersion")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([documentId])
  @@map("document_versions")
}
