generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  ADMIN
}

enum DocumentAccessScope {
  RESTRICTED
  ALL_DEPARTMENTS
}

model Department {
  id                  String                         @id @default(uuid()) @db.Uuid
  name                String                         @unique
  users               User[]
  documentPermissions DocumentDepartmentPermission[]
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  email        String            @unique
  role         UserRole          @default(EMPLOYEE)
  departmentId String            @map("department_id") @db.Uuid
  department   Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  documents    Document[]
  uploads      DocumentVersion[] @relation("VersionUploader")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@index([departmentId])
  @@map("users")
}

model Document {
  id                    String                         @id @default(uuid()) @db.Uuid
  title                 String
  uploaderId            String                         @map("uploader_id") @db.Uuid
  uploader              User                           @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  versions              DocumentVersion[]              @relation("DocumentVersions")
  currentVersionId      String?                        @unique @map("current_version_id") @db.Uuid
  currentVersion        DocumentVersion?               @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  tags                  DocumentTag[]
  accessScope           DocumentAccessScope            @default(RESTRICTED) @map("access_scope")
  departmentPermissions DocumentDepartmentPermission[]
  createdAt             DateTime                       @default(now()) @map("created_at")
  updatedAt             DateTime                       @updatedAt @map("updated_at")
  deletedAt             DateTime?                      @map("deleted_at")

  @@index([uploaderId])
  @@index([title])
  @@index([deletedAt])
  @@map("documents")
}

model DocumentVersion {
  id               String    @id @default(uuid()) @db.Uuid
  documentId       String    @map("document_id") @db.Uuid
  document         Document  @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int       @map("version_number")
  originalFilename String    @map("original_filename")
  storageKey       String    @unique @map("storage_key")
  mimeType         String    @map("mime_type")
  fileSize         BigInt    @map("file_size")
  uploaderId       String    @map("uploader_id") @db.Uuid
  uploader         User      @relation("VersionUploader", fields: [uploaderId], references: [id], onDelete: Restrict)
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  currentFor       Document? @relation("CurrentDocumentVersion")

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@index([uploaderId])
  @@map("document_versions")
}

model Tag {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique
  documents DocumentTag[]
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("tags")
}

model DocumentTag {
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tagId      String   @map("tag_id") @db.Uuid
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  taggedAt   DateTime @default(now()) @map("tagged_at")

  @@id([documentId, tagId])
  @@index([tagId])
  @@map("document_tags")
}

model DocumentDepartmentPermission {
  documentId   String     @map("document_id") @db.Uuid
  document     Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  departmentId String     @map("department_id") @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now()) @map("granted_at")

  @@id([documentId, departmentId])
  @@index([departmentId])
  @@map("document_department_permissions")
}
